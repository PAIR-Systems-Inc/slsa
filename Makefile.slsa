THIRD_PARTY_NOTICES ?= THIRD_PARTY_LICENSES.html
SELF := $(MAKE) -f Makefile.slsa

GOODMEM_VERSION = $(shell git tag --merged HEAD --list "server-v*" 2>/dev/null | sort -V | tail -n1 || echo "server-v0.0.0")
BUILD_COMMIT_SHA = $(shell git rev-parse HEAD 2>/dev/null || echo "unknown")
BUILD_GIT_DESCRIBE = $(shell git describe --tags --always --match="server-v*" --dirty 2>/dev/null || echo "unknown")

SHELL := /bin/bash
.SHELLFLAGS := -e -u -o pipefail -c

# ---------------------------------------------------------------------------
# bump-tag: create a local lightweight tag based on versions.txt state.
# If versions.txt was modified in this commit → stable release (server-vX.Y.Z).
# Otherwise → preview release (server-vX.Y.Z-preview.N).
# Must run before any target that needs GOODMEM_VERSION / BUILD_GIT_DESCRIBE.
# Idempotent — skips if the tag already exists.
# ---------------------------------------------------------------------------
.PHONY: bump-tag
bump-tag:
	@if [ -f versions.txt ] && ! git diff --quiet HEAD~1 -- versions.txt 2>/dev/null; then \
		VERSION=$$(cat versions.txt | tr -d '[:space:]') && \
		NEXT_TAG="server-v$$VERSION" && \
		echo "Stable release: $$NEXT_TAG"; \
	else \
		LATEST_TAG=$$(git tag --merged HEAD --list "server-v*" 2>/dev/null | sort -V | tail -n1) && \
		test -n "$$LATEST_TAG" || { echo "Error: No server-v* tags found" >&2; exit 1; } && \
		if echo "$$LATEST_TAG" | grep -q -- '-preview\.'; then \
			BASE=$$(echo "$$LATEST_TAG" | sed 's/-preview\.[0-9]*$$//') && \
			PREV_NUM=$$(echo "$$LATEST_TAG" | sed 's/.*-preview\.//') && \
			NEXT_TAG="$$BASE-preview.$$((PREV_NUM + 1))"; \
		else \
			NEXT_TAG="$$LATEST_TAG-preview.1"; \
		fi && \
		echo "Preview release: $$NEXT_TAG"; \
	fi && \
	if git rev-parse "$$NEXT_TAG" >/dev/null 2>&1; then \
		echo "Tag $$NEXT_TAG already exists — skipping"; \
	else \
		git tag "$$NEXT_TAG" HEAD && \
		echo "Created local tag $$NEXT_TAG"; \
	fi

.PHONY: image-prefix
image-prefix:
	@if [ "$(DRAFT_RELEASE)" = "true" ]; then \
		echo "ghcr.io/pair-systems-inc/goodmem/not-for-release-server"; \
	else \
		echo "ghcr.io/pair-systems-inc/goodmem/server"; \
	fi

# After bump-tag has run, GOODMEM_VERSION already points to the bumped tag.
# current-version just strips the server-v prefix.
.PHONY: current-version
current-version:
	@echo "$(GOODMEM_VERSION)" | sed 's/^server-v//'

.PHONY: release-tag
release-tag:
	@echo "$(GOODMEM_VERSION)"

.PHONY: docker-tags
docker-tags:
	@PREFIX=$$($(SELF) --no-print-directory image-prefix) && \
	VERSION=$$($(SELF) --no-print-directory current-version) && \
	if echo "$$VERSION" | grep -q -- '-preview\.'; then \
		echo "$$PREFIX:v$$VERSION,$$PREFIX:preview,$$PREFIX:$(BUILD_COMMIT_SHA)"; \
	else \
		echo "$$PREFIX:v$$VERSION,$$PREFIX:latest,$$PREFIX:$(BUILD_COMMIT_SHA)"; \
	fi

.PHONY: docker-build-args
docker-build-args:
	@echo "GOODMEM_VERSION=$(GOODMEM_VERSION)"
	@echo "BUILD_COMMIT_SHA=$(BUILD_COMMIT_SHA)"
	@echo "BUILD_GIT_DESCRIBE=$(BUILD_GIT_DESCRIBE)"
	@echo "THIRD_PARTY_LICENSES=$(THIRD_PARTY_NOTICES)"

.PHONY: docker-labels
docker-labels:
	@echo "org.opencontainers.image.version=$(GOODMEM_VERSION)"
	@echo "org.opencontainers.image.revision=$(BUILD_COMMIT_SHA)"
	@echo "org.opencontainers.image.created=$$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	@echo "org.opencontainers.image.description=GoodMem memory management server"
	@echo "org.opencontainers.image.title=GoodMem Server"

.PHONY: github-release
github-release:
	@PREFIX=$$($(SELF) --no-print-directory image-prefix) && \
	VERSION=$$($(SELF) --no-print-directory current-version) && \
	RELEASE_FLAGS="" && \
	IS_PREVIEW=false && \
	if [ "$(DRAFT_RELEASE)" = "true" ]; then RELEASE_FLAGS="--draft"; fi && \
	if echo "$$VERSION" | grep -q -- '-preview\.'; then IS_PREVIEW=true; fi && \
	echo "Promoting server image..." && \
	TAGS=("$$PREFIX:v$$VERSION" "$$PREFIX:$(BUILD_COMMIT_SHA)") && \
	if [ "$$IS_PREVIEW" = true ]; then \
		TAGS+=("$$PREFIX:preview"); \
	else \
		TAGS+=("$$PREFIX:latest"); \
	fi && \
	for TAG in "$${TAGS[@]}"; do \
		echo "  $$PREFIX@$$DIGEST -> $$TAG" && \
		docker buildx imagetools create --tag "$$TAG" "$$PREFIX@$$DIGEST"; \
	done && \
	TAG="server-v$$VERSION" && \
	echo "Creating release $$TAG..." && \
	gh -R "$$GITHUB_REPOSITORY" release create "$$TAG" $$RELEASE_FLAGS --generate-notes && \
	echo "Uploading provenance attestations..." && \
	find "$$ATTESTATIONS_DIR" -type f | while IFS= read -r file; do \
		gh -R "$$GITHUB_REPOSITORY" release upload "$$TAG" "$$file"; \
	done && \
	echo "Uploading build artifacts..." && \
	find "$$ARTIFACTS_DIR" -type f | while IFS= read -r file; do \
		gh -R "$$GITHUB_REPOSITORY" release upload "$$TAG" "$$file"; \
	done && \
	if [ "$$IS_PREVIEW" = true ]; then \
		echo "Updating rolling server-preview release..." && \
		gh -R "$$GITHUB_REPOSITORY" release delete server-preview --yes 2>/dev/null || true && \
		gh -R "$$GITHUB_REPOSITORY" release create server-preview \
			--title "Latest Preview ($$TAG)" \
			--notes "Rolling preview release. Points to $$TAG." && \
		find "$$ARTIFACTS_DIR" -type f | while IFS= read -r file; do \
			gh -R "$$GITHUB_REPOSITORY" release upload server-preview "$$file"; \
		done; \
	fi
