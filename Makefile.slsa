THIRD_PARTY_NOTICES ?= THIRD_PARTY_LICENSES.html
SELF := $(MAKE) -f Makefile.slsa

# ---------------------------------------------------------------------------
# Version computation
#
# version.txt is the single source of truth for the base version (e.g. 1.2.3).
# The first release of a base version is that version's stable release; every
# later release of the same base version is an edge release whose number
# increments from the last edge tag.
# ---------------------------------------------------------------------------
BASE_VERSION := $(shell cat version.txt 2>/dev/null | tr -d '[:space:]')

# Tag that marks "this base version has already had its stable release".
STABLE_TAG := server-v$(BASE_VERSION)

# Stable when this base version has not been released yet, edge otherwise.
#
# The rule is state-based — "has server-v<BASE_VERSION> shipped?" — rather than
# a diff of version.txt between HEAD and HEAD's first parent. The diff was only
# ever true on the one commit whose first-parent diff carried the bump, so the
# stable release was lost whenever that commit was not the commit released:
# a rebase merge or any multi-commit push puts the bump behind the pushed tip,
# and a release run that fails on the bump commit never gets a second chance —
# every later push then built an edge of a version that never shipped stable
# (goodmem 1.0.310). Asking whether the version has shipped is independent of
# merge style and self-heals after a failed run.
#
# A stable tag already on HEAD means this exact commit's stable release is being
# rebuilt, so re-runs stay idempotent instead of turning into an edge release.
IS_EDGE_RELEASE := $(shell \
  if [ -z "$(BASE_VERSION)" ]; then \
    echo "true"; \
  elif git tag --points-at HEAD 2>/dev/null | grep -Fxq "$(STABLE_TAG)"; then \
    echo "false"; \
  elif git rev-parse -q --verify "refs/tags/$(STABLE_TAG)" >/dev/null 2>&1; then \
    echo "true"; \
  else \
    echo "false"; \
  fi)

# ---------------------------------------------------------------------------
# Compute GOODMEM_VERSION
#
# Stable:  server-v1.2.3
# Edge:    server-v1.2.3-edge.N  (N = last edge tag + 1, starting from 1)
#
# The edge suffix is a semver pre-release ("-edge.N"), not "_edge_N". This
# string is stamped into the CLI binary via ldflags and parsed with semver at
# runtime; an underscore is not valid semver, so edge builds made
# `goodmem upgrade` fail outright ("invalid semantic version").
#
# Tag scanning accepts the legacy "_edge_N" spelling as well so the counter
# keeps incrementing across the format change. Only the new form is emitted.
# ---------------------------------------------------------------------------
ifeq ($(IS_EDGE_RELEASE),true)
  # Edge number already tagged on HEAD (empty if none)
  HEAD_EDGE := $(shell \
    git tag --points-at HEAD 2>/dev/null \
      | grep -E "^server-v$(BASE_VERSION)(_edge_|-edge\.)" \
      | sed -E 's/.*(_edge_|-edge\.)//' | sort -n | tail -1)

  # Highest edge number across all tags for this base version (0 if none)
  LAST_EDGE := $(shell \
    last=$$(git tag -l "server-v$(BASE_VERSION)_edge_*" \
                       "server-v$(BASE_VERSION)-edge.*" 2>/dev/null \
      | sed -E 's/.*(_edge_|-edge\.)//' | sort -n | tail -1); \
    echo "$${last:-0}")

  ifdef HEAD_EDGE
    # HEAD was already tagged — reuse that number (idempotent)
    GOODMEM_VERSION := server-v$(BASE_VERSION)-edge.$(HEAD_EDGE)
  else
    # No tag on HEAD — increment from the last edge tag
    GOODMEM_VERSION := server-v$(BASE_VERSION)-edge.$(shell echo $$(( $(LAST_EDGE) + 1 )))
  endif
else
  GOODMEM_VERSION := server-v$(BASE_VERSION)
endif

BUILD_COMMIT_SHA  := $(shell git rev-parse HEAD 2>/dev/null || echo "unknown")
BUILD_GIT_DESCRIBE := $(shell git describe --tags --always --match="server-v*" --dirty 2>/dev/null || echo "unknown")

SHELL := /bin/bash
.SHELLFLAGS := -e -u -o pipefail -c

# ---------------------------------------------------------------------------
# Version targets
# ---------------------------------------------------------------------------

# Bare version string (e.g. 1.2.3 or 1.2.3-edge.2)
.PHONY: current-version
current-version:
	@echo "$(GOODMEM_VERSION)" | sed 's/^server-v//'

# Full git tag (e.g. server-v1.2.3-edge.2)
.PHONY: release-tag
release-tag:
	@echo "$(GOODMEM_VERSION)"

# Previous stable server tag to use as the release-note baseline for official
# stable releases. Preview and non-server tags are intentionally excluded.
.PHONY: previous-stable-release-tag
previous-stable-release-tag:
	@if [[ "$(GOODMEM_VERSION)" =~ ^server-v[0-9]+\.[0-9]+\.[0-9]+$$ ]]; then \
		git tag -l 'server-v*' \
			| grep -E '^server-v[0-9]+\.[0-9]+\.[0-9]+$$' \
			| grep -Fxv "$(GOODMEM_VERSION)" \
			| sort -V \
			| tail -n1; \
	fi

# Release note args for gh release create. Only official stable server releases
# anchor generated notes to the prior stable server release.
.PHONY: release-note-args
release-note-args:
	@PREVIOUS_TAG=$$($(SELF) --no-print-directory previous-stable-release-tag); \
	if [[ -n "$$PREVIOUS_TAG" ]]; then \
		echo "--notes-start-tag=$$PREVIOUS_TAG"; \
	fi

# gh release flags (--draft when DRAFT_RELEASE=true, empty otherwise)
.PHONY: release-flags
release-flags:
	@if [ "$(DRAFT_RELEASE)" = "true" ]; then \
		echo "--draft"; \
	elif [ "$(IS_EDGE_RELEASE)" = "true" ]; then \
		echo "--prerelease"; \
	fi

# Create a local lightweight tag. Idempotent.
.PHONY: bump-tag
bump-tag:
	@test -n "$(BASE_VERSION)" || { echo "Error: version.txt is missing or empty" >&2; exit 1; }
	@if git rev-parse "$(GOODMEM_VERSION)" >/dev/null 2>&1; then \
		echo "Tag $(GOODMEM_VERSION) already exists — skipping"; \
	else \
		git tag "$(GOODMEM_VERSION)" HEAD && \
		echo "Created local tag $(GOODMEM_VERSION)"; \
	fi

# ---------------------------------------------------------------------------
# Docker targets
# ---------------------------------------------------------------------------

# Image name prefix (draft releases use a separate not-for-release path)
.PHONY: image-prefix
image-prefix:
	@if [ "$(DRAFT_RELEASE)" = "true" ]; then \
		echo "ghcr.io/pair-systems-inc/goodmem/not-for-release-server"; \
	else \
		echo "ghcr.io/pair-systems-inc/goodmem/server"; \
	fi

# Comma-separated image tags for docker build/push
.PHONY: docker-tags
docker-tags:
	@PREFIX=$$($(SELF) --no-print-directory image-prefix) && \
	VERSION=$$($(SELF) --no-print-directory current-version) && \
	if [ "$(IS_EDGE_RELEASE)" = "true" ]; then \
		echo "$$PREFIX:v$$VERSION,$$PREFIX:edge,$$PREFIX:$(BUILD_COMMIT_SHA)"; \
	else \
		echo "$$PREFIX:v$$VERSION,$$PREFIX:latest,$$PREFIX:$(BUILD_COMMIT_SHA)"; \
	fi

# Build args passed to docker build
.PHONY: docker-build-args
docker-build-args:
	@echo "GOODMEM_VERSION=$(GOODMEM_VERSION)"
	@echo "BUILD_COMMIT_SHA=$(BUILD_COMMIT_SHA)"
	@echo "BUILD_GIT_DESCRIBE=$(BUILD_GIT_DESCRIBE)"
	@echo "THIRD_PARTY_LICENSES=$(THIRD_PARTY_NOTICES)"

# OCI labels
.PHONY: docker-labels
docker-labels:
	@echo "org.opencontainers.image.version=$(GOODMEM_VERSION)"
	@echo "org.opencontainers.image.revision=$(BUILD_COMMIT_SHA)"
	@echo "org.opencontainers.image.created=$$(date -u +%Y-%m-%dT%H:%M:%SZ)"
	@echo "org.opencontainers.image.description=GoodMem memory management server"
	@echo "org.opencontainers.image.title=GoodMem Server"

# ---------------------------------------------------------------------------
# Third-party notices
#
# The image's $(THIRD_PARTY_NOTICES) is the FOSSA attribution report of the
# analysis the caller uploaded for this commit before the release workflow.
# These targets only read it back: FOSSA keeps one analysis per revision, so
# every release job uses the same one.
# ---------------------------------------------------------------------------

# FOSSA CLI release that reads the report; the download is checked against
# this digest. Kept out of the workspace, which is the docker build context.
FOSSA_CLI_VERSION := 3.20.5
FOSSA_CLI_SHA256 := aef60ed1eb51fbb2c0ae86625884b44acf279d93201aa7b09d650b5c12801c7b
FOSSA_CLI_DIR ?= $(or $(RUNNER_TEMP),/tmp)/fossa-cli-$(FOSSA_CLI_VERSION)

# Package-locator prefixes the notices must contain: one per ecosystem the
# caller's .fossa.yml targets (gradle: mvn+, gomod: go+).
NOTICES_REQUIRED_LOCATORS ?= mvn+ go+

# Write $(THIRD_PARTY_NOTICES) from the caller's FOSSA analysis of this commit
# Env: FOSSA_API_KEY
.PHONY: third-party-notices
third-party-notices: $(FOSSA_CLI_DIR)/fossa
	@test -n "$${FOSSA_API_KEY:-}" || { echo "FOSSA_API_KEY is not set" >&2; exit 1; }
	@echo "Fetching third-party notices for $(BUILD_COMMIT_SHA)..."
	@"$(FOSSA_CLI_DIR)/fossa" report attribution --format html --revision "$(BUILD_COMMIT_SHA)" > "$(THIRD_PARTY_NOTICES)"
	@$(SELF) --no-print-directory check-third-party-notices

# Fail unless $(THIRD_PARTY_NOTICES) lists packages of every required ecosystem
.PHONY: check-third-party-notices
check-third-party-notices:
	@for locator in $(NOTICES_REQUIRED_LOCATORS); do \
		grep -qF -- "$$locator" "$(THIRD_PARTY_NOTICES)" || { \
			echo "$(THIRD_PARTY_NOTICES) lists no '$$locator' packages: the FOSSA analysis of $(BUILD_COMMIT_SHA) is incomplete" >&2; \
			exit 1; \
		}; \
	done
	@echo "$(THIRD_PARTY_NOTICES) lists packages of: $(NOTICES_REQUIRED_LOCATORS)"

# Release runners are linux/amd64
$(FOSSA_CLI_DIR)/fossa:
	@[ "$$(uname -sm)" = "Linux x86_64" ] || { echo "the pinned FOSSA CLI is linux/amd64; this is $$(uname -sm)" >&2; exit 1; }
	@mkdir -p "$(FOSSA_CLI_DIR)"
	@curl -fsSL --retry 3 -o "$(FOSSA_CLI_DIR)/fossa.tar.gz" \
		"https://github.com/fossas/fossa-cli/releases/download/v$(FOSSA_CLI_VERSION)/fossa_$(FOSSA_CLI_VERSION)_linux_amd64.tar.gz"
	@echo "$(FOSSA_CLI_SHA256)  $(FOSSA_CLI_DIR)/fossa.tar.gz" | sha256sum -c -
	@tar -xzf "$(FOSSA_CLI_DIR)/fossa.tar.gz" -C "$(FOSSA_CLI_DIR)" fossa
	@rm "$(FOSSA_CLI_DIR)/fossa.tar.gz"

# ---------------------------------------------------------------------------
# Release pipeline
#
# github-release orchestrates the steps below in order.
# ---------------------------------------------------------------------------

# Env: DIGEST
# Uses: image-prefix, docker-tags
.PHONY: promote-docker-image
promote-docker-image:
	@IMAGE=$$($(SELF) --no-print-directory image-prefix) && \
	IFS=',' read -ra TAGS <<< "$$($(SELF) --no-print-directory docker-tags)" && \
	for TAG in "$${TAGS[@]}"; do \
		echo "  $$IMAGE@$$DIGEST -> $$TAG" && \
		docker buildx imagetools create --tag "$$TAG" "$$IMAGE@$$DIGEST"; \
	done

# Env: GITHUB_REPOSITORY
# Uses: release-flags, GOODMEM_VERSION, BUILD_COMMIT_SHA
#
# --target pins the new tag to the commit that was actually built. Without it
# gh tags the default branch's current tip, so a release cut from an older
# commit plants its tag on whatever landed on main in the meantime — which then
# feeds the tag-based version state above.
.PHONY: create-github-release
create-github-release:
	@FLAGS=$$($(SELF) --no-print-directory release-flags) && \
	RELEASE_NOTE_ARGS=$$($(SELF) --no-print-directory release-note-args) && \
	echo "Creating release $(GOODMEM_VERSION) at $(BUILD_COMMIT_SHA)..." && \
	gh -R "$$GITHUB_REPOSITORY" release create "$(GOODMEM_VERSION)" \
		--target "$(BUILD_COMMIT_SHA)" $$FLAGS $$RELEASE_NOTE_ARGS --generate-notes

# Env: GITHUB_REPOSITORY, ATTESTATIONS_DIR
# Uses: GOODMEM_VERSION
.PHONY: upload-attestations
upload-attestations:
	@find "$$ATTESTATIONS_DIR" -type f | while IFS= read -r file; do \
		gh -R "$$GITHUB_REPOSITORY" release upload "$(GOODMEM_VERSION)" "$$file"; \
	done

# Env: GITHUB_REPOSITORY, ARTIFACTS_DIR
# Uses: GOODMEM_VERSION
.PHONY: upload-artifacts
upload-artifacts:
	@find "$$ARTIFACTS_DIR" -type f | while IFS= read -r file; do \
		gh -R "$$GITHUB_REPOSITORY" release upload "$(GOODMEM_VERSION)" "$$file"; \
	done

# Env: GITHUB_REPOSITORY, ATTESTATIONS_DIR, ARTIFACTS_DIR
# Uses: release-flags, GOODMEM_VERSION
.PHONY: update-rolling-edge
update-rolling-edge:
	@FLAGS=$$($(SELF) --no-print-directory release-flags) && \
	echo "Updating rolling server-edge release..." && \
	gh -R "$$GITHUB_REPOSITORY" release delete server-edge --yes 2>/dev/null || true && \
	gh -R "$$GITHUB_REPOSITORY" release create server-edge \
		$$FLAGS \
		--title "Latest Edge ($(GOODMEM_VERSION))" \
		--notes "Rolling edge release. Points to $(GOODMEM_VERSION)." && \
	find "$$ATTESTATIONS_DIR" -type f | while IFS= read -r file; do \
		gh -R "$$GITHUB_REPOSITORY" release upload server-edge "$$file"; \
	done && \
	find "$$ARTIFACTS_DIR" -type f | while IFS= read -r file; do \
		gh -R "$$GITHUB_REPOSITORY" release upload server-edge "$$file"; \
	done

.PHONY: github-release
github-release:
	$(SELF) promote-docker-image
	$(SELF) create-github-release
	$(SELF) upload-attestations
	$(SELF) upload-artifacts
	@if [ "$(IS_EDGE_RELEASE)" = "true" ]; then \
		$(SELF) update-rolling-edge; \
	fi

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
.PHONY: test
test:
	@echo "Running Makefile.slsa tests..." && \
	MAKEFILE="$$(cd "$$(dirname $(MAKEFILE_LIST))" && pwd)/$$(basename $(MAKEFILE_LIST))" && \
	MK="make -f \"$$MAKEFILE\" --no-print-directory SELF=\"make -f $$MAKEFILE\"" && \
	TMPDIR=$$(mktemp -d) && \
	trap 'rm -rf "$$TMPDIR"' EXIT && \
	cd "$$TMPDIR" && \
	git init -q && git commit --allow-empty -q -m "init" && \
	\
	echo "--- Test 1: Stable release (version.txt changed in HEAD) ---" && \
	echo "1.2.3" > version.txt && \
	git add version.txt && git commit -q -m "set version 1.2.3" && \
	git tag server-v1.2.3 && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "1.2.3" ] || { echo "FAIL: expected 1.2.3, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 2: First edge release (no prior edge tags) ---" && \
	git commit --allow-empty -q -m "feature A" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "1.2.3-edge.1" ] || { echo "FAIL: expected 1.2.3-edge.1, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 3: bump-tag creates tag, is idempotent ---" && \
	eval $$MK bump-tag && \
	eval $$MK bump-tag && \
	echo "  bump-tag idempotent  OK" && \
	\
	echo "--- Test 4: Version stable after bump-tag (HEAD_EDGE) ---" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "1.2.3-edge.1" ] || { echo "FAIL: expected 1.2.3-edge.1, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 5: Edge increments from previous tag ---" && \
	git commit --allow-empty -q -m "feature B" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "1.2.3-edge.2" ] || { echo "FAIL: expected 1.2.3-edge.2, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 6: Third edge release after bump-tag ---" && \
	eval $$MK bump-tag && \
	git commit --allow-empty -q -m "feature C" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "1.2.3-edge.3" ] || { echo "FAIL: expected 1.2.3-edge.3, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 7: release-tag includes server-v prefix ---" && \
	RESULT=$$(eval $$MK release-tag) && \
	[ "$$RESULT" = "server-v1.2.3-edge.3" ] || { echo "FAIL: expected server-v1.2.3-edge.3, got $$RESULT" >&2; exit 1; } && \
	echo "  release-tag = $$RESULT  OK" && \
	\
	echo "--- Test 8: New stable release ---" && \
	echo "2.0.0" > version.txt && \
	git add version.txt && git commit -q -m "bump to 2.0.0" && \
	git tag java-client-v9.9.9 && \
	git tag foo-bar && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "2.0.0" ] || { echo "FAIL: expected 2.0.0, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 9: previous-stable-release-tag ignores edge and non-server tags ---" && \
	RESULT=$$(eval $$MK previous-stable-release-tag) && \
	[ "$$RESULT" = "server-v1.2.3" ] || { echo "FAIL: expected server-v1.2.3, got $$RESULT" >&2; exit 1; } && \
	echo "  previous-stable-release-tag = $$RESULT  OK" && \
	\
	echo "--- Test 10: release-note-args anchors stable notes to prior stable release ---" && \
	RESULT=$$(eval $$MK release-note-args) && \
	[ "$$RESULT" = "--notes-start-tag=server-v1.2.3" ] || { echo "FAIL: expected --notes-start-tag=server-v1.2.3, got $$RESULT" >&2; exit 1; } && \
	echo "  release-note-args = $$RESULT  OK" && \
	\
	echo "--- Test 11: Edge resets to 1 after the version's stable release ---" && \
	eval $$MK bump-tag && \
	git commit --allow-empty -q -m "feature D" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "2.0.0-edge.1" ] || { echo "FAIL: expected 2.0.0-edge.1, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 12: image-prefix for normal release ---" && \
	RESULT=$$(eval $$MK image-prefix) && \
	[ "$$RESULT" = "ghcr.io/pair-systems-inc/goodmem/server" ] || { echo "FAIL: expected normal prefix, got $$RESULT" >&2; exit 1; } && \
	echo "  image-prefix = $$RESULT  OK" && \
	\
	echo "--- Test 13: image-prefix for draft release ---" && \
	RESULT=$$(eval $$MK image-prefix DRAFT_RELEASE=true) && \
	[ "$$RESULT" = "ghcr.io/pair-systems-inc/goodmem/not-for-release-server" ] || { echo "FAIL: expected draft prefix, got $$RESULT" >&2; exit 1; } && \
	echo "  image-prefix = $$RESULT  OK" && \
	\
	echo "--- Test 14: release-flags empty for stable release ---" && \
	eval $$MK bump-tag && \
	echo "2.1.0" > version.txt && \
	git add version.txt && git commit -q -m "bump to 2.1.0" && \
	RESULT=$$(eval $$MK release-flags) && \
	[ -z "$$RESULT" ] || { echo "FAIL: expected empty, got $$RESULT" >&2; exit 1; } && \
	echo "  release-flags = (empty)  OK" && \
	\
	echo "--- Test 15: release-flags --draft for draft stable release ---" && \
	RESULT=$$(eval $$MK release-flags DRAFT_RELEASE=true) && \
	[ "$$RESULT" = "--draft" ] || { echo "FAIL: expected --draft, got $$RESULT" >&2; exit 1; } && \
	echo "  release-flags = $$RESULT  OK" && \
	\
	echo "--- Test 16: docker-tags :latest for stable release ---" && \
	RESULT=$$(eval $$MK docker-tags) && \
	echo "$$RESULT" | grep -q ":latest" || { echo "FAIL: expected :latest in $$RESULT" >&2; exit 1; } && \
	echo "$$RESULT" | grep -qv ":edge" || { echo "FAIL: unexpected :edge in $$RESULT" >&2; exit 1; } && \
	echo "  docker-tags = $$RESULT  OK" && \
	\
	echo "--- Test 17: release-flags --prerelease for edge ---" && \
	eval $$MK bump-tag && \
	git commit --allow-empty -q -m "feature E" && \
	RESULT=$$(eval $$MK release-flags) && \
	[ "$$RESULT" = "--prerelease" ] || { echo "FAIL: expected --prerelease, got $$RESULT" >&2; exit 1; } && \
	echo "  release-flags = $$RESULT  OK" && \
	\
	echo "--- Test 18: release-note-args empty for edge releases ---" && \
	RESULT=$$(eval $$MK release-note-args) && \
	[ -z "$$RESULT" ] || { echo "FAIL: expected empty release-note-args, got $$RESULT" >&2; exit 1; } && \
	echo "  release-note-args = (empty)  OK" && \
	\
	echo "--- Test 19: release-flags --draft overrides --prerelease ---" && \
	RESULT=$$(eval $$MK release-flags DRAFT_RELEASE=true) && \
	[ "$$RESULT" = "--draft" ] || { echo "FAIL: expected --draft, got $$RESULT" >&2; exit 1; } && \
	echo "  release-flags = $$RESULT  OK" && \
	\
	echo "--- Test 20: docker-tags :edge for edge release ---" && \
	RESULT=$$(eval $$MK docker-tags) && \
	echo "$$RESULT" | grep -q ":edge" || { echo "FAIL: expected :edge in $$RESULT" >&2; exit 1; } && \
	echo "$$RESULT" | grep -qv ":latest" || { echo "FAIL: unexpected :latest in $$RESULT" >&2; exit 1; } && \
	echo "  docker-tags = $$RESULT  OK" && \
	\
	echo "--- Test 21: docker-tags uses draft image prefix ---" && \
	RESULT=$$(eval $$MK docker-tags DRAFT_RELEASE=true) && \
	echo "$$RESULT" | grep -q "not-for-release-server" || { echo "FAIL: expected not-for-release-server in $$RESULT" >&2; exit 1; } && \
	echo "  docker-tags = $$RESULT  OK" && \
	\
	echo "--- Test 22: merge commit bumping version.txt is a stable release ---" && \
	git checkout -q -b feature-branch && \
	echo "3.0.0" > version.txt && \
	git add version.txt && git commit -q -m "bump to 3.0.0" && \
	git checkout -q - && \
	git merge -q --no-ff -m "Merge pull request: bump to 3.0.0" feature-branch && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "3.0.0" ] || { echo "FAIL: expected 3.0.0 (stable) for version-bumping merge, got $$RESULT" >&2; exit 1; } && \
	RESULT=$$(eval $$MK release-flags) && \
	[ -z "$$RESULT" ] || { echo "FAIL: expected empty release-flags (stable) for merge, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = 3.0.0  OK" && \
	\
	echo "--- Test 23: merge commit not touching version.txt is an edge release ---" && \
	eval $$MK bump-tag && \
	git checkout -q -b feature-branch-2 && \
	git commit --allow-empty -q -m "feature without version bump" && \
	git checkout -q - && \
	git merge -q --no-ff -m "Merge pull request: no version bump" feature-branch-2 && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "3.0.0-edge.1" ] || { echo "FAIL: expected 3.0.0-edge.1 (edge) for non-bumping merge, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = 3.0.0-edge.1  OK" && \
	\
	echo "--- Test 24: bump behind the pushed tip is still stable ---" && \
	eval $$MK bump-tag && \
	echo "4.0.0" > version.txt && \
	git add version.txt && git commit -q -m "bump to 4.0.0" && \
	git commit --allow-empty -q -m "later commit in the same push" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "4.0.0" ] || { echo "FAIL: expected 4.0.0 (stable) when the bump is not the released commit, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 25: stable survives a failed run on the bump commit ---" && \
	eval $$MK bump-tag && \
	echo "5.0.0" > version.txt && \
	git add version.txt && git commit -q -m "bump to 5.0.0" && \
	git commit --allow-empty -q -m "next commit; the bump commit's run never released" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "5.0.0" ] || { echo "FAIL: expected 5.0.0 (stable) after a failed run on the bump commit, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 26: re-running a stable release stays stable ---" && \
	eval $$MK bump-tag && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "5.0.0" ] || { echo "FAIL: expected 5.0.0 on stable re-run, got $$RESULT" >&2; exit 1; } && \
	RESULT=$$(eval $$MK release-flags) && \
	[ -z "$$RESULT" ] || { echo "FAIL: expected empty release-flags on stable re-run, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = 5.0.0, release-flags = (empty)  OK" && \
	\
	echo "--- Test 27: edge starts at 1 after a stable release, then increments ---" && \
	git commit --allow-empty -q -m "first commit after the stable release" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "5.0.0-edge.1" ] || { echo "FAIL: expected 5.0.0-edge.1, got $$RESULT" >&2; exit 1; } && \
	eval $$MK bump-tag && \
	git commit --allow-empty -q -m "second commit after the stable release" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "5.0.0-edge.2" ] || { echo "FAIL: expected 5.0.0-edge.2, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = 5.0.0-edge.1 then 5.0.0-edge.2  OK" && \
	\
	echo "--- Test 28: create-github-release tags the commit that was built ---" && \
	SHA=$$(git rev-parse HEAD) && \
	RESULT=$$(eval $$MK -n create-github-release) && \
	echo "$$RESULT" | grep -qF -- "--target \"$$SHA\"" || { echo "FAIL: expected --target \"$$SHA\" in the recipe, got: $$RESULT" >&2; exit 1; } && \
	echo "  create-github-release targets $$SHA  OK" && \
	\
	echo "--- Test 29: edge counter continues across the legacy _edge_ format ---" && \
	echo "6.0.0" > version.txt && \
	git add version.txt && git commit -q -m "set version 6.0.0" && \
	git tag server-v6.0.0 && \
	git commit --allow-empty -q -m "post-stable commit" && \
	git tag server-v6.0.0_edge_3 && \
	git commit --allow-empty -q -m "next commit" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "6.0.0-edge.4" ] || { echo "FAIL: expected 6.0.0-edge.4 (continue past legacy _edge_3), got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 30: legacy _edge_ tag on HEAD is reused as its own number ---" && \
	git commit --allow-empty -q -m "commit carrying a legacy tag" && \
	git tag server-v6.0.0_edge_9 && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "6.0.0-edge.9" ] || { echo "FAIL: expected 6.0.0-edge.9 from legacy tag on HEAD, got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 31: double-digit edge numbers sort numerically, not lexically ---" && \
	git commit --allow-empty -q -m "commit after edge 9" && \
	git tag server-v6.0.0-edge.10 && \
	git commit --allow-empty -q -m "commit after edge 10" && \
	RESULT=$$(eval $$MK current-version) && \
	[ "$$RESULT" = "6.0.0-edge.11" ] || { echo "FAIL: expected 6.0.0-edge.11 (numeric sort past 9), got $$RESULT" >&2; exit 1; } && \
	echo "  current-version = $$RESULT  OK" && \
	\
	echo "--- Test 32: check-third-party-notices passes when every ecosystem is listed ---" && \
	printf '%s\n' '<a href="#mvn+com.google.errorprone:error_prone_annotation$$2.49.0" class="summary-table__link">' \
		'<a href="#go+code.gitea.io/sdk/gitea$$v0.22.1" class="summary-table__link">' > notices.html && \
	eval $$MK check-third-party-notices THIRD_PARTY_NOTICES=notices.html >/dev/null || { echo "FAIL: expected notices listing mvn+ and go+ to pass" >&2; exit 1; } && \
	echo "  mvn+ and go+ listed  OK" && \
	\
	echo "--- Test 33: check-third-party-notices fails when an ecosystem is missing ---" && \
	printf '%s\n' '<a href="#go+code.gitea.io/sdk/gitea$$v0.22.1" class="summary-table__link">' > notices.html && \
	if eval $$MK check-third-party-notices THIRD_PARTY_NOTICES=notices.html >/dev/null 2>&1; then echo "FAIL: expected notices without mvn+ to fail" >&2; exit 1; fi && \
	echo "  go+ only rejected  OK" && \
	\
	echo "--- Test 34: check-third-party-notices fails on an empty file ---" && \
	printf '\n' > notices.html && \
	if eval $$MK check-third-party-notices THIRD_PARTY_NOTICES=notices.html >/dev/null 2>&1; then echo "FAIL: expected empty notices to fail" >&2; exit 1; fi && \
	echo "  empty file rejected  OK" && \
	\
	echo "" && echo "All tests passed."
